# Copy this file to `.env.local` for local development and adjust as needed.
# `.env.local` is gitignored — never commit real values.

# Public API base URL. Vite replaces this value in the browser bundle at
# BUILD time. It must be the publicly reachable backend URL; VITE_* variables
# are sent to the browser and must never contain secrets.

# Production (Render backend)
VITE_API_URL=https://abdelkhalek-store.onrender.com

# Local development (optional — when unset, the dev server falls back to this)
# VITE_API_URL=http://localhost:8000